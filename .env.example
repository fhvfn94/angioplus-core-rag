# Copy to .env and set your key (never commit .env).
GEMINI_API_KEY=
TELEGRAM_BOT_TOKEN=
GEMINI_AUDIO_MODEL=gemini-3.5-flash
MAX_VOICE_DURATION_SECONDS=120
# Shared secret between the bot and the RAG API (X-API-Key header).
# Required: /ask returns 503 while it is unset.
RAG_API_KEY=
# Comma-separated Telegram user IDs allowed to use the bot.
# Empty means everyone is allowed.
TELEGRAM_ALLOWED_USER_IDS=
# Optional; set when Qdrant requires an API key.
# QDRANT_API_KEY=
# Optional; default in scripts is models/gemini-embedding-001 (must match ingest and ask).
# GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001
