# Copy to .env and set your key (never commit .env).
GEMINI_API_KEY=
TELEGRAM_BOT_TOKEN=
GEMINI_AUDIO_MODEL=gemini-3.5-flash
MAX_VOICE_DURATION_SECONDS=120
RAG_TIMEOUT_SECONDS=180
SOURCE_LIMIT=3
SOURCE_SCORE_THRESHOLD=0.0
# Optional; default in scripts is models/gemini-embedding-001 (must match ingest and ask).
# GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# Query normalization and conversation context
QUERY_NORMALIZATION_ENABLED=true
QUERY_CONTEXT_ENABLED=false
CONVERSATION_TTL_SECONDS=1800
CONVERSATION_MAX_TURNS=3
QUERY_LOW_SCORE_LOG_THRESHOLD=0.45

