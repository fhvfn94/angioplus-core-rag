# syntax=docker/dockerfile:1
FROM python:3.12-slim-bookworm

WORKDIR /app

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

# Layer 1: CPU-only PyTorch (separate, so it can be cached on its own and
# is not replaced by a CUDA build later). Uses BuildKit pip cache mount.
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --upgrade pip \
    && pip install --index-url https://download.pytorch.org/whl/cpu torch==2.13.0+cpu

# Layer 2: ML dependencies (sentence-transformers / transformers),
# constrained so they never pull a different torch.
COPY requirements-constraints.txt requirements-ml.txt ./
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install -c requirements-constraints.txt -r requirements-ml.txt

# Layer 3: frequent RAG/app dependencies (openai, FastAPI, Qdrant, readers).
# Changing these does NOT invalidate the CPU torch / ML layers above.
COPY requirements-rag.txt ./
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install -r requirements-rag.txt
